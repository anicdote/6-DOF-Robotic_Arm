<?xml version="1.0"?>
<sdf version="1.9">
  <world name="color_pick_place">
    <gravity>0 0 -9.81</gravity>
    <physics name="step_1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 2.5 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2 2 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2 2 0.02</size></box></geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
            <pbr><metal><roughness>0.85</roughness></metal></pbr>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.01 0 0 0</pose>
    </model>

    <model name="red_pick_cube">
      <pose>0.260 0.020 0.020 0 0 0</pose>
      <link name="link">
        <!-- Pick/place uses SetEntityPose grasp assistance.  Disable gravity
             so the cube cannot fall between pose updates and visibly bounce. -->
        <gravity>false</gravity>
        <inertial>
          <mass>0.035</mass>
          <inertia>
            <ixx>0.0000093</ixx><iyy>0.0000093</iyy><izz>0.0000093</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.040 0.040 0.040</size></box></geometry>
          <surface>
            <friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.040 0.040 0.040</size></box></geometry>
          <material>
            <ambient>0.85 0.01 0.01 1</ambient>
            <diffuse>1.00 0.02 0.02 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="green_pick_cube">
      <pose>0.220 0.145 0.020 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.035</mass>
          <inertia>
            <ixx>0.0000093</ixx><iyy>0.0000093</iyy><izz>0.0000093</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.040 0.040 0.040</size></box></geometry>
          <surface>
            <friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.040 0.040 0.040</size></box></geometry>
          <material>
            <ambient>0.01 0.65 0.04 1</ambient>
            <diffuse>0.02 0.95 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_pick_cube">
      <pose>0.210 -0.105 0.020 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <inertial>
          <mass>0.035</mass>
          <inertia>
            <ixx>0.0000093</ixx><iyy>0.0000093</iyy><izz>0.0000093</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.040 0.040 0.040</size></box></geometry>
          <surface>
            <friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.040 0.040 0.040</size></box></geometry>
          <material>
            <ambient>0.01 0.08 0.75 1</ambient>
            <diffuse>0.02 0.12 1.00 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="placement_tray">
      <static>true</static>
      <pose>0.200 -0.180 0.012 0 0 0</pose>
      <link name="link">
        <collision name="base_collision">
          <geometry><box><size>0.110 0.110 0.010</size></box></geometry>
        </collision>
        <visual name="base_visual">
          <geometry><box><size>0.110 0.110 0.010</size></box></geometry>
          <material>
            <ambient>0.85 0.65 0.05 1</ambient>
            <diffuse>0.95 0.75 0.08 1</diffuse>
          </material>
        </visual>
        <collision name="wall_x1">
          <pose>0.052 0 0.022 0 0 0</pose>
          <geometry><box><size>0.006 0.110 0.045</size></box></geometry>
        </collision>
        <collision name="wall_x2">
          <pose>-0.052 0 0.022 0 0 0</pose>
          <geometry><box><size>0.006 0.110 0.045</size></box></geometry>
        </collision>
        <collision name="wall_y1">
          <pose>0 0.052 0.022 0 0 0</pose>
          <geometry><box><size>0.110 0.006 0.045</size></box></geometry>
        </collision>
        <collision name="wall_y2">
          <pose>0 -0.052 0.022 0 0 0</pose>
          <geometry><box><size>0.110 0.006 0.045</size></box></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
