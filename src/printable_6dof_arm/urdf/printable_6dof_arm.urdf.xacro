<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="printable_cad_arm">

  <xacro:arg name="target_color" default="red"/>

  <!-- Measured pivot-to-pivot dimensions from the user-supplied STL files. -->
  <xacro:property name="shoulder_length" value="0.120"/>
  <xacro:property name="elbow_length" value="0.204"/>
  <xacro:property name="wrist_length" value="0.179"/>

  <!-- Neutral robot colours cannot enter the red / green / blue HSV masks. -->
  <material name="cad_blue"><color rgba="0.42 0.46 0.52 1"/></material>
  <material name="cad_dark"><color rgba="0.07 0.09 0.13 1"/></material>
  <material name="cad_orange"><color rgba="0.68 0.70 0.74 1"/></material>
  <material name="camera_blue"><color rgba="0.18 0.20 0.24 1"/></material>

  <!-- A virtual world joint represents the four mounting bolts used by the
       real arm and prevents the simulator from treating it as a free body. -->
  <link name="world"/>
  <joint name="world_mount_joint" type="fixed">
    <parent link="world"/>
    <child link="base_footprint"/>
  </joint>
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <!-- Base.stl is the radial floor plate and cylindrical motor housing. -->
      <geometry><mesh filename="package://printable_6dof_arm/meshes/cad/base.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cad_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0284"/>
      <geometry><cylinder radius="0.0865" length="0.0568"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.026"/>
      <mass value="0.85"/>
      <inertia ixx="0.0019" ixy="0" ixz="0" iyy="0.0019" iyz="0" izz="0.0032"/>
    </inertial>
  </link>

  <!-- The physical arm is bolted through this pedestal.  Keep only the
       mounting link kinematic so the articulated links still use physics. -->
  <gazebo reference="base_link">
    <kinematic>true</kinematic>
    <gravity>false</gravity>
  </gazebo>

  <!-- The CAD contains a stepper-driven waist, so this axis is continuous. -->
  <joint name="joint1_base_yaw" type="continuous">
    <parent link="base_link"/>
    <child link="base_yaw_link"/>
    <origin xyz="0 0 0.05675"/>
    <axis xyz="0 0 1"/>
    <limit effort="20.0" velocity="0.80"/>
    <dynamics damping="0.15" friction="0.06"/>
  </joint>

  <link name="base_yaw_link">
    <visual>
      <!-- Waist.stl is the rotating top plate and shoulder arch. -->
      <geometry><mesh filename="package://printable_6dof_arm/meshes/cad/waist.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cad_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.002"/>
      <geometry><cylinder radius="0.049" length="0.004"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.026 -0.007 0.033" rpy="0 -0.45 0"/>
      <geometry><box size="0.074 0.012 0.054"/></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.010 -0.004 0.015"/>
      <mass value="0.30"/>
      <inertia ixx="0.00032" ixy="0" ixz="0" iyy="0.00038" iyz="0" izz="0.00028"/>
    </inertial>
  </link>

  <joint name="joint2_shoulder_pitch" type="revolute">
    <parent link="base_yaw_link"/>
    <child link="shoulder_link"/>
    <!-- Measured centre of the 17.9 mm shoulder bore in Waist.stl. -->
    <origin xyz="-0.0129 -0.0072 0.0403"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.20" upper="1.20" effort="18.0" velocity="0.65"/>
    <dynamics damping="0.20" friction="0.08"/>
  </joint>

  <link name="shoulder_link">
    <visual>
      <geometry><mesh filename="package://printable_6dof_arm/meshes/cad/shoulder_arm.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cad_orange"/>
    </visual>
    <collision>
      <origin xyz="0.058 0 0"/>
      <geometry><box size="0.166 0.030 0.044"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.060 0 0"/>
      <mass value="0.22"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00055" iyz="0" izz="0.00055"/>
    </inertial>
  </link>

  <joint name="joint3_elbow_pitch" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="${shoulder_length} 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.60" upper="2.60" effort="15.0" velocity="0.70"/>
    <dynamics damping="0.16" friction="0.06"/>
  </joint>

  <link name="elbow_link">
    <!-- G_Arm and H_arm are the paired CAD side plates. -->
    <visual>
      <origin xyz="0 0.023 0"/>
      <geometry><mesh filename="package://printable_6dof_arm/meshes/cad/elbow_left.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cad_blue"/>
    </visual>
    <visual>
      <origin xyz="0 -0.023 0"/>
      <geometry><mesh filename="package://printable_6dof_arm/meshes/cad/elbow_right.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cad_blue"/>
    </visual>
    <collision>
      <origin xyz="0.100 0 0"/>
      <geometry><box size="0.250 0.075 0.044"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.102 0 0"/>
      <mass value="0.32"/>
      <inertia ixx="0.00020" ixy="0" ixz="0" iyy="0.00120" iyz="0" izz="0.00120"/>
    </inertial>
  </link>

  <joint name="joint4_wrist_pitch" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="${elbow_length} 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.60" upper="2.60" effort="8.0" velocity="0.90"/>
    <dynamics damping="0.12" friction="0.04"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <geometry><mesh filename="package://printable_6dof_arm/meshes/cad/wrist_arm.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cad_orange"/>
    </visual>
    <collision>
      <origin xyz="0.090 0 0"/>
      <geometry><box size="0.229 0.030 0.040"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.090 0 0"/>
      <mass value="0.20"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.00075"/>
    </inertial>
  </link>

  <joint name="gripper_palm_joint" type="fixed">
    <parent link="wrist_link"/>
    <child link="gripper_palm_link"/>
    <origin xyz="${wrist_length} 0 0"/>
  </joint>

  <link name="gripper_palm_link">
    <visual>
      <geometry><mesh filename="package://printable_6dof_arm/meshes/cad/gripper_palm.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cad_dark"/>
    </visual>
    <collision>
      <!-- Keep the finger channel open; the CAD palm is not a solid cuboid. -->
      <origin xyz="0.003 0 0"/>
      <geometry><box size="0.022 0.070 0.042"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.050 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00016" iyz="0" izz="0.00018"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="revolute">
    <parent link="gripper_palm_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0.010 0.040 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.35" upper="0.0" effort="5.0" velocity="0.60"/>
    <dynamics damping="0.15" friction="0.08"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <geometry><mesh filename="package://printable_6dof_arm/meshes/cad/left_finger.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cad_orange"/>
    </visual>
    <collision>
      <!-- Collision is limited to the hinge; simulation uses smooth
           pose-follow grasp assistance so the visual finger cannot kick the cube. -->
      <origin xyz="0.010 0 0"/>
      <geometry><box size="0.025 0.010 0.014"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.050 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000028" iyz="0" izz="0.000028"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="revolute">
    <parent link="gripper_palm_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.010 -0.040 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.35" effort="5.0" velocity="0.60"/>
    <dynamics damping="0.15" friction="0.08"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <geometry><mesh filename="package://printable_6dof_arm/meshes/cad/right_finger.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="cad_orange"/>
    </visual>
    <collision>
      <origin xyz="0.010 0 0"/>
      <geometry><box size="0.025 0.010 0.014"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.050 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000028" iyz="0" izz="0.000028"/>
    </inertial>
  </link>

  <joint name="tool_tip_joint" type="fixed">
    <parent link="gripper_palm_link"/>
    <child link="tool_tip"/>
    <!-- Measured grasp centre between the 107 mm CAD fingers. -->
    <origin xyz="0.090 0 0"/>
  </joint>
  <link name="tool_tip"/>

  <!-- A visible bracket fixes the camera to the rotating top plate. -->
  <joint name="camera_bracket_joint" type="fixed">
    <parent link="base_yaw_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="0.025 0.035 0.004"/>
  </joint>
  <link name="camera_mount_link">
    <visual>
      <origin xyz="0 0 0.045"/>
      <geometry><box size="0.014 0.014 0.090"/></geometry>
      <material name="camera_blue"/>
    </visual>
    <visual>
      <origin xyz="0.0175 0.020 0.090" rpy="0 0 0.852"/>
      <geometry><box size="0.055 0.014 0.014"/></geometry>
      <material name="camera_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.045"/>
      <geometry><box size="0.014 0.014 0.090"/></geometry>
    </collision>
    <collision>
      <origin xyz="0.0175 0.020 0.090" rpy="0 0 0.852"/>
      <geometry><box size="0.055 0.014 0.014"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.008 0.010 0.050"/>
      <mass value="0.035"/>
      <inertia ixx="0.000025" ixy="0" ixz="0" iyy="0.000025" iyz="0" izz="0.000008"/>
    </inertial>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_link"/>
    <origin xyz="0.035 0.040 0.096" rpy="0 0.45 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0.012 0 0"/>
      <geometry><box size="0.030 0.030 0.022"/></geometry>
      <material name="camera_blue"/>
    </visual>
    <collision>
      <origin xyz="0.012 0 0"/>
      <geometry><box size="0.030 0.030 0.022"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0.012 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="0.000004" ixy="0" ixz="0" iyy="0.000004" iyz="0" izz="0.000004"/>
    </inertial>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5708 0 -1.5708"/>
  </joint>
  <link name="camera_optical_frame"/>

  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <joint name="joint1_base_yaw">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2_shoulder_pitch">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-1.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3_elbow_pitch">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.7</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4_wrist_pitch">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.5</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_finger_joint">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo reference="left_finger_link">
    <mu1>5.0</mu1><mu2>5.0</mu2><kp>100000</kp><kd>10</kd>
  </gazebo>
  <gazebo reference="right_finger_link">
    <mu1>5.0</mu1><mu2>5.0</mu2><kp>100000</kp><kd>10</kd>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="base_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <topic>/arm_camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <camera_info_topic>/arm_camera/camera_info</camera_info_topic>
        <horizontal_fov>1.5708</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.025</near><far>3.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find printable_6dof_arm)/config/arm_controllers.yaml</parameters>
      <!-- Default 0.1 is too soft for the mass of the imported CAD links. -->
      <position_proportional_gain>0.50</position_proportional_gain>
    </plugin>
  </gazebo>
</robot>
